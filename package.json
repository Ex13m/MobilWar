{
  "name": "mobilwar",
  "private": true,
  "version": "0.1.0",
  "description": "MobilWar — location-based AR multiplayer shooter (PWA) for small outdoor groups",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter ./apps/* dev",
    "dev:server": "pnpm --filter @mobilwar/server dev",
    "dev:client": "pnpm --filter @mobilwar/client dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "start": "pnpm --filter @mobilwar/server start"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
